# --- Dragonfly Scanner -- Environment Variables ---
# Set these as Cloud Run environment variables via:
#   gcloud run services update dragonfly-scanner --region us-east1 --set-env-vars="KEY=VALUE"

# Claude Vision API (required for product scanning)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Email notifications (required for signup emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-email@gmail.com
SMTP_PASS=your-gmail-app-password
NOTIFY_EMAIL=sasha@dopestr.com
FROM_EMAIL=noreply@dragonflybrandny.com

# Admin access to view all signups at /api/signups?key=YOUR_KEY
ADMIN_KEY=change-this-to-a-secret

# Loyalty: signing secret for session tokens. Optional - falls back to ADMIN_KEY if unset.
# Rotating this invalidates all existing loyalty sessions.
LOYALTY_SECRET=another-long-random-string

# Persistence: enable GCS write-through for data/*.json.
# Without GCS_BUCKET, server uses local files only (ephemeral on Cloud Run).
# When set, on startup the server hydrates local files from the bucket, and
# each save is mirrored back to the bucket (2s debounce).
# Files persisted: products.json, accounts.json, receipts.json, scrape-sites.json.
# Auth: Cloud Run service account needs roles/storage.objectAdmin on this bucket.
# Locally: set GOOGLE_APPLICATION_CREDENTIALS to a JSON key path.
GCS_BUCKET=dragonfly-scanner-data
GCS_PREFIX=dragonfly/

# Cloud Run sets PORT automatically (default 8080)
# PORT=8080
